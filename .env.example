# ========================================================
# SentinelForge Environment Configuration
# ========================================================

# Application Mode: local | zero_cost_cloud
APP_MODE=local

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=*

# Privacy-First RAG Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=.sentinelforge/chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Sandbox Security Limits
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_MAX_OUTPUT_BYTES=51200
SANDBOX_ALLOW_NETWORK=false

# LLM Provider Configuration (Zero-Cost / Local)
# Available providers: mock (for fast zero-cost testing), ollama, groq_free
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Active Workspace Root
WORKSPACE_ROOT=.sentinelforge/workspace

